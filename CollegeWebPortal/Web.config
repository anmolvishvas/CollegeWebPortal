<?xml version="1.0" encoding="utf-8"?>
<!--
  College Web Portal - Web.config
  Stores: Connection String, Authentication, Custom Errors, Theme, Session Timeout
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
-->
<configuration>

  <!-- ===================== APP SETTINGS ===================== -->
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="AppName" value="College Web Portal" />
    <add key="CollegeName" value="Sunrise Institute of Technology" />
  </appSettings>

  <!-- ===================== CONNECTION STRING =====================
       Update 'Data Source' to your SQL Server instance name.
       Examples:  .\SQLEXPRESS   |   (localdb)\MSSQLLocalDB   |   localhost
  -->
  <connectionStrings>
    <add name="CollegePortalDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=CollegePortalDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>

    <!-- Target framework 4.8 -->
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Core, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Data.DataSetExtensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />

    <!-- ===================== THEME (applied globally) =====================
         styleSheetTheme applies CollegeTheme as *defaults*, so a control's own
         CssClass can still override the skin when needed. -->
    <pages styleSheetTheme="CollegeTheme" clientIDMode="AutoID" maxPageStateFieldLength="8000">
      <controls>
      </controls>
    </pages>

    <!-- ===================== FORMS AUTHENTICATION ===================== -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="30" defaultUrl="~/Default.aspx" slidingExpiration="true" />
    </authentication>

    <!-- Everyone may reach the login page; other pages are guarded in code / sub-folder configs -->
    <authorization>
      <allow users="*" />
    </authorization>

    <!-- ===================== SESSION STATE ===================== -->
    <sessionState mode="InProc" timeout="30" cookieless="false" />

    <!-- ===================== CUSTOM ERRORS ===================== -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx">
      <error statusCode="404" redirect="~/Error.aspx" />
      <error statusCode="500" redirect="~/Error.aspx" />
    </customErrors>

    <!-- ===================== SITEMAP (role security trimming) ===================== -->
    <siteMap defaultProvider="XmlSiteMapProvider" enabled="true">
      <providers>
        <clear />
        <add name="XmlSiteMapProvider"
             type="System.Web.XmlSiteMapProvider"
             siteMapFile="Web.sitemap"
             securityTrimmingEnabled="true" />
      </providers>
    </siteMap>

  </system.web>

  <system.webServer>
    <httpErrors errorMode="DetailedLocalOnly" />
    <validation validateIntegratedModeConfiguration="false" />
  </system.webServer>

</configuration>
