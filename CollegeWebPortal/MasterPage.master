<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="CollegeWebPortal.MasterPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>College Web Portal</title>

    <!-- Bootstrap 5 + Icons (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Site stylesheet (theme CSS is injected automatically by App_Themes) -->
    <link href="~/CSS/site.css" rel="stylesheet" runat="server" />

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <%-- ScriptManager enables AJAX (UpdatePanel / Timer) on every content page --%>
        <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePartialRendering="true" />

        <!-- ===================== TOP NAVBAR (Logo + Menu) ===================== -->
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" href="~/Default.aspx" runat="server">
                    <img src="~/Images/logo.svg" runat="server" alt="Logo" height="34" class="me-2" />
                    <span class="fw-bold">College Web Portal</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="topNav">
                    <%-- SiteMap driven top menu --%>
                    <asp:SiteMapDataSource ID="TopMenuData" runat="server" ShowStartingNode="false" />
                    <asp:Menu ID="TopMenu" runat="server" DataSourceID="TopMenuData"
                        Orientation="Horizontal" CssClass="navbar-nav me-auto"
                        StaticMenuItemStyle-CssClass="nav-item"
                        StaticSelectedStyle-CssClass="active"
                        MaximumDynamicDisplayLevels="2" />

                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item text-white me-3">
                            <i class="bi bi-person-circle"></i>
                            <asp:Label ID="lblUser" runat="server" Text="" />
                            <span class="badge bg-light text-dark ms-1"><asp:Label ID="lblRole" runat="server" /></span>
                        </li>
                        <li class="nav-item">
                            <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-sm btn-light"
                                OnClick="btnLogout_Click">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </asp:LinkButton>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container-fluid">
            <div class="row">
                <!-- ===================== SIDEBAR (role based) ===================== -->
                <aside class="col-lg-2 col-md-3 app-sidebar p-0">
                    <div class="sidebar-heading text-uppercase small fw-bold px-3 py-2">
                        <asp:Label ID="lblSidebarTitle" runat="server" Text="Menu" />
                    </div>
                    <asp:Literal ID="litSidebar" runat="server" />
                </aside>

                <!-- ===================== MAIN CONTENT ===================== -->
                <main class="col-lg-10 col-md-9 app-content py-3">
                    <!-- Breadcrumb navigation -->
                    <nav aria-label="breadcrumb">
                        <asp:SiteMapPath ID="Breadcrumb" runat="server" CssClass="breadcrumb-nav"
                            PathSeparator=" / " RenderCurrentNodeAsLink="false">
                        </asp:SiteMapPath>
                    </nav>

                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </main>
            </div>
        </div>

        <!-- ===================== FOOTER ===================== -->
        <footer class="app-footer text-center py-3 mt-4">
            <div class="container">
                <span>&copy; <asp:Literal ID="litYear" runat="server" /> Sunrise Institute of Technology &mdash; College Web Portal.
                    Built with ASP.NET Web Forms.</span>
            </div>
        </footer>
    </form>

    <!-- jQuery + Bootstrap bundle (CDN) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= ResolveUrl("~/JS/site.js") %>"></script>
</body>
</html>
